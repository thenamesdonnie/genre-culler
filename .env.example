# Spotify app credentials from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match the redirect URI registered on that dashboard
REDIRECT_URI=http://localhost:3320/callback
PORT=3320
# The playlist the culler opens by default. Optional.
DEFAULT_PLAYLIST=
# Optional: only needed for the LLM genre classifier
ANTHROPIC_API_KEY=
# Optional: Last.fm tag lookups, https://www.last.fm/api/account/create
LASTFM_API_KEY=

# MusicBrainz asks for a contact in the user-agent. An email or a URL.
MB_CONTACT=
